{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Video Storyboard & Prompt Specification",
  "description": "Structured input format for ai-video-script-director deterministic compiler and validator.",
  "type": "object",
  "required": ["project", "continuity_bible", "shots"],
  "properties": {
    "project": {
      "type": "object",
      "required": ["title", "aspect_ratio", "target_duration_sec"],
      "properties": {
        "title": { "type": "string" },
        "genre": { "type": "string", "examples": ["TVC Commercial", "Short Film", "TikTok/Reels", "Trailer"] },
        "logline": { "type": "string" },
        "aspect_ratio": { "type": "string", "enum": ["16:9", "9:16", "2.39:1", "1:1", "4:5"] },
        "target_duration_sec": { "type": "number", "minimum": 3 },
        "primary_platform": {
          "type": "string",
          "enum": ["seedance", "google-flow", "runway", "kling", "sora", "all"]
        },
        "workflow_mode": {
          "type": "string",
          "enum": ["i2v-keyframes", "ingredients", "first-last-frame", "t2v"]
        }
      }
    },
    "continuity_bible": {
      "type": "object",
      "required": ["style_lock"],
      "properties": {
        "style_lock": {
          "type": "string",
          "description": "Invariant English lens, film stock, lighting aesthetic, and color grade suffix."
        },
        "color_palette": {
          "type": "array",
          "items": { "type": "string" }
        },
        "ingredients": {
          "type": "array",
          "description": "Locked characters, products, or locations mapped to @ImageN / Flow Ingredients.",
          "items": {
            "type": "object",
            "required": ["id", "tag", "kind", "name", "invariant_description"],
            "properties": {
              "id": { "type": "string", "examples": ["CHAR_1", "PROD_1", "ENV_1"] },
              "tag": { "type": "string", "examples": ["@Image1", "@Image2", "@Image3"] },
              "kind": { "type": "string", "enum": ["character", "product", "environment"] },
              "name": { "type": "string" },
              "short_anchor": {
                "type": "string",
                "description": "Concise English noun phrase used when @Image tag already locks appearance."
              },
              "invariant_description": {
                "type": "string",
                "description": "Complete static English visual specification for T2V and Reference Sheet generation."
              }
            }
          }
        }
      }
    },
    "shots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "shot_number",
          "title",
          "duration_sec",
          "framing",
          "camera_move",
          "subject_state",
          "action",
          "environment",
          "lighting"
        ],
        "properties": {
          "shot_number": { "type": "integer", "minimum": 1 },
          "title": { "type": "string" },
          "narrative_beat": { "type": "string", "examples": ["Hook", "Build", "Climax", "CTA"] },
          "duration_sec": { "type": "number", "minimum": 2, "maximum": 20 },
          "ingredient_refs": {
            "type": "array",
            "items": { "type": "string" },
            "description": "IDs from continuity_bible.ingredients appearing in this shot."
          },
          "director_note": { "type": "string" },
          "framing": { "type": "string" },
          "camera_move": { "type": "string" },
          "subject_state": {
            "type": "string",
            "description": "Static starting pose and subject arrangement (used for First Frame + T2V/Seedance)."
          },
          "action": {
            "type": "string",
            "description": "Primary kinetic action unfolding over the clip."
          },
          "secondary_physics": {
            "type": "string",
            "description": "Environmental and material physics (steam, wind, droplets, reflections)."
          },
          "environment": { "type": "string" },
          "lighting": { "type": "string" },
          "last_frame_state": {
            "type": "string",
            "description": "Optional static ending composition for Google Flow / Kling First-to-Last Frame mode."
          },
          "transition_out": { "type": "string" },
          "audio": {
            "type": "object",
            "properties": {
              "sfx": { "type": "string" },
              "dialogue": { "type": "string" },
              "dialogue_lang": { "type": "string", "default": "Vietnamese" },
              "delivery": { "type": "string" },
              "is_voiceover": { "type": "boolean", "default": false },
              "music": { "type": "string" },
              "include_bgm_in_video_gen": { "type": "boolean", "default": false }
            }
          }
        }
      }
    }
  }
}
